# Solo si publicas el sitio en una subruta (p. ej. https://dominio.com/armeria).
# Debe coincidir con `basePath` en next.config.ts. Déjalo vacío para la raíz del dominio.
NEXT_PUBLIC_BASE_PATH=

# Búsqueda de armas fuera del catálogo (nivel 3: IA con búsqueda web). Sin clave, solo Wikipedia.
# ANTHROPIC_API_KEY=sk-ant-...
# ARMAS_IA=1            # fuerza activar/desactivar (0) aunque la credencial llegue por otra vía
# ARMAS_IA_MAX_DIA=40   # consultas IA por día (toda la instancia)
# ARMAS_IA_MAX_IP_HORA=5
