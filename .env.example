# Solo si publicas el sitio en una subruta (p. ej. https://dominio.com/armeria).
# Debe coincidir con `basePath` en next.config.ts. Déjalo vacío para la raíz del dominio.
NEXT_PUBLIC_BASE_PATH=

# Búsqueda de armas fuera del catálogo (nivel 3: IA con búsqueda web). Sin clave, solo Wikipedia.
# ANTHROPIC_API_KEY=sk-ant-...
# ARMAS_IA=1            # fuerza activar/desactivar (0) aunque la credencial llegue por otra vía
# ARMAS_IA_MAX_DIA=40   # consultas IA por día (toda la instancia)
# ARMAS_IA_MAX_IP_HORA=5

# Constructor 3D (/montar, visor, miniaturas WebGL, botones «montar en 3D»). Apagado si falta o vale distinto de «true».
# Se lee al compilar: tras cambiarlo hay que volver a ejecutar `npm run dev` o `npm run build`.
NEXT_PUBLIC_ENABLE_3D=false

# Base de datos PostgreSQL (Neon u otra): contenido de las fichas.
DATABASE=postgresql://usuario:contraseña@host/basededatos?sslmode=require

# Panel de administración (/admin): un único usuario. Solo servidor, nunca NEXT_PUBLIC_.
# Si falta alguno (o SESSION_SECRET tiene menos de 32 caracteres) el acceso queda cerrado.
# Genera el secreto con: openssl rand -base64 48
# Cambiar ADMIN_PASSWORD o SESSION_SECRET cierra las sesiones abiertas.
ADMIN_USER=
ADMIN_PASSWORD=
SESSION_SECRET=

# S3 (bucket PRIVADO): las imágenes se sirven por la ruta /img/… de la app. Solo servidor, nunca NEXT_PUBLIC_.
S3_AWS_ACCESS_KEY=
S3_AWS_SECRET_KEY=
S3_AWS_REGION=us-east-1
S3_BUCKET=
S3_FOLDER=armeria
